# =============================================================================
#  НЕФТЬ · Coffee Bot — что не отправлять в контекст сборки образа
#
#  Главное: секреты не должны попасть в образ ни при каких условиях.
#  Данные монтируются томом, поэтому в образе им делать нечего.
# =============================================================================

# --- Секреты ------------------------------------------------------------------
.env
.env.*
credentials.json

# --- Рабочие данные -----------------------------------------------------------
data/
*.db
*.sqlite3
Backup/

# --- Окружение и кеши ---------------------------------------------------------
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# --- Git и служебное ----------------------------------------------------------
.git/
.gitignore
.github/
Patches/
*.patch

# --- Документация и лишние файлы ----------------------------------------------
README*.md
WEB_SETUP.md
command_reminder.MD
Internal_Context.md
*.xlsx
.vscode/
