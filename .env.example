# =============================================================================
#  НЕФТЬ · Coffee Bot — переменные окружения
#
#  Скопируйте файл в .env и заполните значения:
#      cp .env.example .env
#
#  .env не попадает в git — секреты остаются только на сервере.
# =============================================================================

# --- Основное ----------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8001
WEB_TIMEZONE=Europe/Moscow

# --- Сессии -------------------------------------------------------------------
# Ключ подписи cookie. Сгенерировать:  openssl rand -hex 32
# Если пусто, берётся токен бота из credentials.json.
WEB_SESSION_SECRET=

# 1 — cookie отдаётся только по HTTPS. На сервере с сертификатом ставьте 1.
WEB_COOKIE_SECURE=1

# --- Вход через Telegram ------------------------------------------------------
# Имя бота без @. Пока не задано, виджет входа не показывается.
# Домен обязательно должен быть указан у BotFather:
#   /mybots → ваш бот → Bot Settings → Domain
TELEGRAM_BOT_USERNAME=NeftCoffeeBot

# Публичный HTTPS-адрес обработчика callback. Telegram требует именно HTTPS.
TELEGRAM_AUTH_CALLBACK_URL=https://neftcoffee.shop/auth/telegram/callback

# Токен бота. Если задан, credentials.json на сервере не нужен.
TELEGRAM_BOT_TOKEN=

# --- Google Sheets ------------------------------------------------------------
# Нужно только старому боту (bot/handlers/*), сайт этим не пользуется.
# Данные сервисного аккаунта одной строкой JSON. Получить строку:
#   python -c "import json;print(json.dumps(json.load(open('credentials.json')),separators=(',',':')))"
# Если задано, файл credentials.json не нужен.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Истории гостей -----------------------------------------------------------
# Каталог с базой историй и загруженными фото.
# Пусто — по умолчанию берётся <проект>/data/stories.
NEFT_DATA_DIR=/opt/coffee_bot/data/stories

# --- Где лежит база -----------------------------------------------------------
# Если не задавать, база берётся как coffee_quality.db в корне проекта.
# Для Docker этот путь уже прописан в docker-compose.yml — дублировать не нужно.
# Для установки без Docker удобно держать её вместе с остальными данными
# (четыре слэша перед абсолютным путём — синтаксис SQLAlchemy для SQLite):
# DATABASE_URL=sqlite:////opt/coffee_bot/data/coffee_quality.db
