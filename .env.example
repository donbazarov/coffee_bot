# =============================================================================
#  НЕФТЬ · Coffee Bot — переменные окружения
#
#  Скопируйте файл в .env и заполните значения:
#      cp .env.example .env
#
#  .env не попадает в git — секреты остаются только на сервере.
# =============================================================================

# --- Основное ----------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8001
WEB_TIMEZONE=Europe/Moscow

# --- Сессии -------------------------------------------------------------------
# Ключ подписи cookie. Сгенерировать:  openssl rand -hex 32
# Если пусто, берётся токен бота (TELEGRAM_BOT_TOKEN).
WEB_SESSION_SECRET=

# 1 — cookie отдаётся только по HTTPS. На сервере с сертификатом ставьте 1.
WEB_COOKIE_SECURE=1

# --- Web Push (необязательно) --------------------------------------------------
# VAPID-ключи создаются автоматически при первом запуске и лежат в базе
# (таблица web_push_keys) — вручную ничего делать не нужно. Переопределить
# можно приватным ключом в PEM или base64 от PEM (тогда публичный выведется из него):
# VAPID_PRIVATE_KEY=
# Контакт для push-сервисов: push принимает только `mailto:` или `https:`.
# VAPID_SUBJECT=mailto:support@neftcoffee.shop

# --- Способы входа ------------------------------------------------------------
# 1 — включить вход через Telegram (кнопка, виджет и роуты /auth/telegram/*).
# Выключено: с сервера недоступен api.telegram.org. Штатный вход — «iiko_id + код доступа».
AUTH_TELEGRAM_ENABLED=0

# 1 — разрешить исходящие вызовы Bot API: публикации в каналы и фото профиля из Telegram.
# Пока выключено: недоступный Telegram висит таймаутом 20 с внутри запроса
# сохранения графика, и nginx отдаёт 504, хотя график уже сохранён.
TELEGRAM_OUTBOUND_ENABLED=0

# --- Вход через Telegram (требует AUTH_TELEGRAM_ENABLED=1) ---------------------
# Имя бота без @. Пока не задано, виджет входа не показывается.
# Домен обязательно должен быть указан у BotFather:
#   /mybots → ваш бот → Bot Settings → Domain
TELEGRAM_BOT_USERNAME=NeftCoffeeBot

# Публичный HTTPS-адрес обработчика callback. Telegram требует именно HTTPS.
TELEGRAM_AUTH_CALLBACK_URL=https://neftcoffee.shop/auth/telegram/callback

# Токен бота. Обязателен для входа через Telegram.
TELEGRAM_BOT_TOKEN=

# --- Истории гостей -----------------------------------------------------------
# Каталог с базой историй и загруженными фото.
# Оставьте пустым — путь по умолчанию <проект>/data/stories подходит и для
# запуска из исходников, и для работы в контейнере.
#
# Для Docker путь внутри контейнера другой (/app/data/stories), и его уже задаёт
# docker-compose.yml. Если прописать здесь путь хоста, он перебьёт значение из
# compose, и приложение станет искать каталог, которого внутри контейнера нет.
# NEFT_DATA_DIR=/app/data/stories

# --- Аватары сотрудников ------------------------------------------------------
# Каталог с фото профилей. Оставьте пустым — берётся <проект>/data/avatars;
# это подходит и для запуска из исходников, и для контейнера (./data смонтирован).
# В Docker каталог должен принадлежать uid 10001:  chown -R 10001:10001 data
# NEFT_AVATARS_DIR=/app/data/avatars

# --- Где лежит база -----------------------------------------------------------
# Если не задавать, база берётся как coffee_quality.db в корне проекта.
# Для Docker этот путь уже прописан в docker-compose.yml — дублировать не нужно.
# Для установки без Docker удобно держать её вместе с остальными данными
# (четыре слэша перед абсолютным путём — синтаксис SQLAlchemy для SQLite):
# DATABASE_URL=sqlite:////opt/coffee_bot/data/coffee_quality.db
