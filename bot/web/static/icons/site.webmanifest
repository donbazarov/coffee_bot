{
  "name": "НЕФТЬ · Quality Desk",
  "short_name": "НЕФТЬ",
  "description": "Рабочее пространство кофейной команды НЕФТЬ",
  "lang": "ru",
  "start_url": "/?utm_source=pwa",
  "id": "/",
  "scope": "/",
  "share_target": {
    "action": "/chat/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/jpeg", "image/png", "image/webp"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/static/icons/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#10110f",
  "background_color": "#10110f",
  "display": "standalone"
}